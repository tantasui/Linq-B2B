# Linq-B2B environment variables.
#
# Copy to .env.local for development. Every var here is optional at build
# time — src/server/env.ts parses with zod and tolerates missing values so a
# build never fails on config — but the feature flags at the bottom of that
# file turn features OFF when their vars are absent, and an empty string is
# treated as absent (see `emptyToUndefined`). A var left blank below is a
# feature left disabled, not a default.
#
# env.ts parses once at module load, so changing any of these requires a
# restart/redeploy, not just a new request.

# --- Database ---------------------------------------------------------------
# Gates `databaseEnabled`. Without it the app falls back to in-memory stores.
DATABASE_URL=postgres://user:password@host:5432/linq
# "true" (default) or "false". Set false for a local Postgres without TLS.
DATABASE_SSL=true
# Max pooled connections. Digits only; defaults to 5.
DATABASE_POOL_MAX=5

# --- Linq offramp (native per-chain settlement) -----------------------------
# Gates `liveLinqEnabled` — the settlement path for every chain except Stellar.
LINQ_OFFRAMP_API_KEY=
# Defaults to the Koyeb deployment when blank, so it is effectively never unset.
LINQ_OFFRAMP_API_URL=https://confidential-brianna-uselinq-52e2b233.koyeb.app
# Verifies inbound offramp webhook signatures.
LINQ_OFFRAMP_WEBHOOK_SECRET=

# --- Stellar settlement service (github.com/Rinku-Labs/linq-stellar) --------
# Stellar does NOT go through LINQ_OFFRAMP_API_URL. It is a standalone service
# that owns its deposit accounts and watches Horizon itself.
#
# Both vars below gate `stellarServiceEnabled`. Because STELLAR_SERVICE_URL is
# defaulted it is always truthy, which makes STELLAR_SERVICE_API_KEY the only
# var that can disable Stellar — and when it is missing, order creation fails
# with "Stellar settlement service is not configured." (HTTP 503) before any
# request leaves this server.
STELLAR_SERVICE_URL=https://linq-stellar-uselinq-4c0e2a4f.koyeb.app
# REQUIRED for Stellar checkout. Sent as X-API-Key on POST /orders and
# GET /orders/{id}. Must match ORDERS_API_KEY on the linq-stellar deployment
# byte-for-byte — a mismatch returns 401 "invalid or missing X-API-Key"
# instead of the 503 above.
STELLAR_SERVICE_API_KEY=

# --- Paycrest ---------------------------------------------------------------
# Gates `livePaycrestEnabled`.
PAYCREST_API_KEY=
# Defaulted when blank.
PAYCREST_API_URL=https://api.paycrest.io/v2
# Verifies inbound Paycrest webhook signatures.
PAYCREST_WEBHOOK_SECRET=

# --- Dynamic (wallet auth) --------------------------------------------------
# Gates `liveDynamicEnabled`. Public — exposed to the browser.
NEXT_PUBLIC_DYNAMIC_ENV_ID=
DYNAMIC_API_TOKEN=
DYNAMIC_WEBHOOK_SECRET=

# --- Sessions ---------------------------------------------------------------
# Signing secret for merchant session cookies.
LINQ_SESSION_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# Gates `resendEnabled`. Without it, transactional email is skipped.
RESEND_API_KEY=
# Defaults to "Linq <noreply@uselinq.site>" when blank.
EMAIL_FROM=

# --- Redis ------------------------------------------------------------------
# Both required together to gate `redisEnabled` (idempotency + rate limiting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional non-Upstash Redis connection string.
REDIS_URL=

# --- URLs -------------------------------------------------------------------
# Public origin of this app, used to build absolute payment-link URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side only: when set, unmatched Paycrest webhooks are forwarded here.
BACKEND_API_URL=
# Browser-side backend origin for src/lib/api-client.ts. NEXT_PUBLIC_BACKEND_URL
# wins when both are set; both blank means same-origin /api requests. A bare
# host is fine — the client adds https:// and strips a trailing /api.
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_API_BASE_URL=
